{
  "name": "sistema-reserva-labs-urp",
  "version": "1.0.0",
  "description": "Sistema de Reserva de Laboratorios URP + Agente IA y RAG",
  "scripts": {
    "dev:server": "cd server && python -m uvicorn app.main:app --reload --port 3000",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && python -m app.db.seed",
    "test:server": "cd server && python -m pytest",
    "start": "cd server && python -m uvicorn app.main:app --port 3000"
  }
}
